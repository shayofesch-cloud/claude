{%- comment -%}
  Outputs BreadcrumbList structured data so search results show a trail (Home › Hoodies › Eze Hoodie)
  instead of a bare URL. Renders nothing on templates without a meaningful trail.
{%- endcomment -%}
{%- liquid
  assign crumb_page_types = 'product,collection,article,blog,page' | split: ','
  assign crumb_collection = blank
  if request.page_type == 'product'
    assign crumb_collection = collection | default: product.collections.first
    if crumb_collection.handle == 'frontpage'
      assign crumb_collection = blank
    endif
  endif
-%}
{%- if crumb_page_types contains request.page_type -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | append: routes.root_url | json }}
        }
        {%- case request.page_type -%}
          {%- when 'product' -%}
            {%- if crumb_collection != blank -%}
              ,{
                "@type": "ListItem",
                "position": 2,
                "name": {{ crumb_collection.title | json }},
                "item": {{ request.origin | append: crumb_collection.url | json }}
              }
            {%- endif -%}
            ,{
              "@type": "ListItem",
              "position": {% if crumb_collection != blank %}3{% else %}2{% endif %},
              "name": {{ product.title | json }},
              "item": {{ request.origin | append: product.url | json }}
            }
          {%- when 'collection' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": {{ request.origin | append: collection.url | json }}
            }
          {%- when 'blog' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ request.origin | append: blog.url | json }}
            }
          {%- when 'article' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": {{ request.origin | append: blog.url | json }}
            }
            ,{
              "@type": "ListItem",
              "position": 3,
              "name": {{ article.title | json }},
              "item": {{ request.origin | append: article.url | json }}
            }
          {%- when 'page' -%}
            ,{
              "@type": "ListItem",
              "position": 2,
              "name": {{ page.title | json }},
              "item": {{ request.origin | append: page.url | json }}
            }
        {%- endcase -%}
      ]
    }
  </script>
{%- endif -%}
